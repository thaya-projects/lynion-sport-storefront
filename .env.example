NEXT_PUBLIC_SITE_URL=https://lynion.thaya.app
NEXT_PUBLIC_WHATSAPP_NUMBER=+59163693408

# Con INVENTORIES_API_URL el catálogo sale de la API pública del backend.
# Sin ella (o con CATALOG_SOURCE=mock) se usan los productos de ejemplo.
INVENTORIES_API_URL=http://localhost:5293/api
STOREFRONT_SLUG=lynion
# Solo cuando el backend active el header X-Storefront-Key.
STOREFRONT_API_KEY=

# Publica datos de producto a buscadores (JSON-LD, og:image, sitemap).
# Activar solo cuando el catálogo venga de la API con datos completos.
PRODUCT_SEO_ENABLED=false

REVALIDATE_SECRET=change-me
